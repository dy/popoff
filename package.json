{
  "name": "popoff",
  "version": "3.0.0",
  "description": "Tooltips, dropdowns, hover cards and modals done one way, on the platform's popover and dialog",
  "type": "module",
  "main": "popoff.js",
  "module": "popoff.js",
  "types": "popoff.d.ts",
  "exports": {
    ".": { "types": "./popoff.d.ts", "default": "./popoff.js" },
    "./start": "./start.js",
    "./start.js": "./start.js"
  },
  "files": ["popoff.js", "popoff.d.ts", "start.js"],
  "sideEffects": ["./start.js"],
  "scripts": {
    "test": "node --test test/test.js && BROWSER=firefox node --test test/test.js && BROWSER=webkit node --test test/test.js"
  },
  "devDependencies": {
    "playwright": "~1.63.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/dy/popoff.git" },
  "keywords": ["tooltip", "popover", "dropdown", "modal", "dialog", "popup", "anchor-positioning", "interestfor", "title"],
  "author": "Dmitry Iv. <df.creative@gmail.com>",
  "license": "MIT",
  "bugs": { "url": "https://github.com/dy/popoff/issues" },
  "homepage": "https://dy.github.io/popoff/"
}
